{
  "name": "nudge",
  "version": "0.1.0",
  "private": true,
  "description": "A calm study companion for macOS",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "start:mac": "node scripts/start-mac.mjs",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "build:ocr": "bash scripts/build-ocr.sh",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "get-windows": "^9.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
